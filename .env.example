APP_NAME=MDS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://mds.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

# Único usuario que crea/conserva CoreSeeder con el rol Administrador.
# Ajusta esto al clonar la plantilla para un proyecto nuevo — no requiere tocar código.
MDS_ADMIN_EMAIL=admin@tu-dominio.com
MDS_ADMIN_NAME="Nombre Apellido"

# Límite de solicitudes por IP contra fuerza bruta/flood en login, 2FA e invitaciones.
# Ver config/security.php.
SECURITY_MAX_REQUESTS_PER_MINUTE=50

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mds
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=180
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Envío de correo por Microsoft Graph (OAuth2 app-only), en vez de SMTP.
# Pon MAIL_MAILER=graph y llena esto con tu propio App Registration de Azure
# AD para este sitio — ver docs/correo-oauth2-azure.md. No reutilices el
# mismo client id/secret entre proyectos, cada uno lleva su propia app.
# AZURE_MAIL_TENANT_ID=
# AZURE_MAIL_CLIENT_ID=
# AZURE_MAIL_CLIENT_SECRET=
# AZURE_MAIL_SENDER="${MAIL_FROM_ADDRESS}"

# Módulo MesaServicio: acceso OAuth2 a la API de ServiceDesk Plus Cloud vía
# Zoho Accounts (Self Client + refresh token permanente) — ver
# docs/servicedesk-plus-oauth.md. Los dominios dependen de la región de tu
# instancia SDP, no los reutilices de otro proyecto/región.
# SDP_CLIENT_ID=
# SDP_CLIENT_SECRET=
# SDP_REFRESH_TOKEN=
# SDP_PORTAL=
# SDP_API_DOMAIN=https://sdpondemand.manageengine.com
# SDP_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# Módulo GestionTI: acceso Basic Auth a la API de Oracle EBS (Oracle
# Integration Cloud) para sincronizar Solicitudes Internas de Compra (SIC) —
# ver docs/gestionti-progreso.md. Sin esto, la captura del folio SIC sigue
# funcionando 100% manual (respaldo intencional, nunca se pierde).
# EBS_BASE_URL=
# EBS_ORGANIZATION_CODE=
# EBS_USERNAME=
# EBS_PASSWORD=

# Módulo GestionTI: almacenamiento de documentos digitalizados en SharePoint
# vía Microsoft Graph (Sites.Selected), configurable por tipo de documento
# desde "Configuración de Almacenamiento" — ver docs/gestionti-progreso.md.
# Reutiliza el mismo App Registration que AZURE_MAIL_* de arriba (mismo
# tenant/client id/secret), solo necesita el permiso Sites.Selected
# consentido y una Application Access Policy que lo acote al sitio.
# SHAREPOINT_SITE_HOSTNAME=grupokosmosmexico.sharepoint.com
# SHAREPOINT_SITE_PATH=/sites/Landit
# SHAREPOINT_FOLDER_RESPONSIVA="Responsivas Asignación de Activos"
# SHAREPOINT_FOLDER_REMISION_PROVEEDOR="Remisiones de Proveedor"
# Sin carpeta configurada todavía (agrega la variable el día que se activen
# en "Configuración de Almacenamiento"):
# SHAREPOINT_FOLDER_SIC=
# SHAREPOINT_FOLDER_FACTURA=
# SHAREPOINT_FOLDER_FACTURA_XML=
# SHAREPOINT_FOLDER_ORDEN_SERVICIO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
